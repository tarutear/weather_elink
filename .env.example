# Weather API Configuration
# Choose one of the following APIs:

# Option 1: OpenWeatherMap (Recommended for getting started)
OPENWEATHER_API_KEY=your_api_key_here
OPENWEATHER_CITY=Seoul
OPENWEATHER_COUNTRY=KR

# Option 2: Korean Meteorological Administration (기상청)
# KMA_API_KEY=your_api_key_here
# KMA_NX=60  # 격자 X 좌표
# KMA_NY=127 # 격자 Y 좌표

# Display Settings
DISPLAY_WIDTH=800
DISPLAY_HEIGHT=480
DISPLAY_MODE=simulation  # simulation or hardware
UPDATE_INTERVAL=3600  # seconds (3600 = 1 hour)

# Location (for API calls)
LATITUDE=37.5665
LONGITUDE=126.9780
TIMEZONE=Asia/Seoul
